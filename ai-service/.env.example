MONGODB_URI=mongodb://localhost:27017/airsense
MONGODB_DATABASE=airsense
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
TRAINING_LOOKBACK_DAYS=30
MODEL_PATH_AQI=xgboost_aqi_model.joblib
MODEL_PATH_PM25=xgboost_pm25_model.joblib

# ---------------------------------------------------------------------------
# CORS — comma-separated list of allowed origins.
# Do NOT use '*' when allow_credentials is enabled.
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ---------------------------------------------------------------------------
# Reload — set to true ONLY in local development; never in production.
# ---------------------------------------------------------------------------
FASTAPI_RELOAD=false

