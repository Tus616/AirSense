MONGODB_URI=mongodb://localhost:27017/airsense
SERVER_PORT=8082
AI_SERVICE_BASE_URL=http://localhost:8000
JWT_SECRET=replace_with_base64_256_bit_secret
JWT_EXPIRATION_MS=86400000
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash
OPENWEATHER_API_KEY=your_openweather_key_here
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.json
GOOGLE_CLOUD_PROJECT_ID=your_gcp_project_id
FUSION_CACHE_DEFAULT_TTL_SECONDS=600
FUSION_CACHE_WEATHER_TTL_SECONDS=300
FUSION_CACHE_SATELLITE_TTL_SECONDS=1800
FUSION_CACHE_GREEN_COVER_TTL_SECONDS=3600
FUSION_CACHE_AQI_TTL_SECONDS=120
FEATURE_VOICE_ASSISTANT=true
FEATURE_POLICY_SIMULATION=true

# ---------------------------------------------------------------------------
# Demo user seeding — DISABLED by default.
# To seed demo users in a local dev environment:
#   1. Set DEMO_SEED_ENABLED=true
#   2. Set all four credential variables below (never use production values)
# Do NOT provide password defaults here or in any committed file.
# ---------------------------------------------------------------------------
DEMO_SEED_ENABLED=false
# DEMO_ADMIN_EMAIL=
# DEMO_ADMIN_PASSWORD=
# DEMO_CITIZEN_EMAIL=
# DEMO_CITIZEN_PASSWORD=

